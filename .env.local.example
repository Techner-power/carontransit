# Copy this file to .env.local and fill in your real Supabase project values.
# Find these in your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Until this file exists with real values, the site runs entirely on the
# mock data in src/lib/mockData.ts — so it works and looks complete from
# day one, no setup required to preview it.
